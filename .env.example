# ──────────────────────────────────────────────────────────────────────
# cloud-ops-ai-agent — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the real .env file — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────

# ── AWS Academy Learner Lab Credentials ──────────────────────────────
# How to obtain these values:
#   1. Open AWS Academy → Learner Lab → click "Start Lab"
#   2. Wait for the indicator to turn GREEN
#   3. Click "AWS Details" (top-right panel)
#   4. Click "Show" next to "AWS CLI"
#   5. Copy the three values below
#
# IMPORTANT: These are TEMPORARY credentials (typically valid for ~4 hours).
#            You must refresh them every time you restart the lab session.
# ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_DEFAULT_REGION=us-east-1

# ── S3 Log Upload Configuration ─────────────────────────────────────
# The bucket MUST already exist in your Learner Lab account.
# Create it via: aws s3 mb s3://your-bucket-name
# ──────────────────────────────────────────────────────────────────────
S3_LOG_BUCKET=cloud-ops-ai-agent-logs
S3_LOG_PREFIX=logs/
